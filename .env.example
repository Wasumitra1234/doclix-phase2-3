# Doclix Phase 3 — set in Vercel / Railway / Render (no laptop required in production)

DATABASE_URL="postgresql://user:password@host:5432/doclix?sslmode=require"

NODE_ENV=production
PORT=4000
APP_URL=https://your-app.vercel.app
API_URL=https://your-api.up.railway.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app

JWT_SECRET=change-me-long-random-32chars-min
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://your-app.vercel.app

# Storage: local | r2 | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OCR: none | google-vision | aws-textract
OCR_PROVIDER=none
